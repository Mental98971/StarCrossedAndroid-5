<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Theme.StarCrossed" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/sc_void</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/sc_void</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/sc_void</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="colorPrimary">@color/sc_cy</item>
        <item name="colorAccent">@color/sc_cy</item>
    </style>

    <!-- Launch/splash theme (androidx.core.splashscreen). MainActivity swaps
         to Theme.StarCrossed itself once installSplashScreen()'s content is
         ready to draw (the library handles the swap timing automatically
         once setContentView has run) — the WebView's own #splash element
         then takes over visually, so the two splash experiences hand off
         seamlessly rather than double-flashing.

         windowSplashScreenAnimatedIcon: the app's own branded icon, shown
         the instant the app launches, before anything else. Was previously
         @drawable/ic_notification (a generic cyan placeholder star, unused
         anywhere else in this exact role) — replaced 2026-08-30 with the
         supplied photo, already used as-is for the app's launcher icon, for
         a consistent brand mark across both surfaces. Background/duration/
         handoff below are all untouched from before. -->
    <style name="Theme.StarCrossed.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sc_void</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_startup_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/sc_void</item>
        <item name="postSplashScreenTheme">@style/Theme.StarCrossed</item>
    </style>

</resources>
